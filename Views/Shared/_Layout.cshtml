	<script>
		$(document).ready(function () {

			$(window).on('load', function () {
				$('#lodeerloder').addClass('hidden'); // Add the 'hidden' class to trigger fadeout animation
			});
			setTimeout(function () {
				$('#lodeerloder').addClass('hidden');
			}, 3000);

			//Add fixed Class in Header
			$(window).scroll(function () {
				if ($(this).scrollTop() > 100) {
					$('.ManiHeader').addClass('fixed');
				} else {
					$('.ManiHeader').removeClass('fixed');
				}
			});

			//Same Height jQuery
			function setEqualHeight() {
				var maxHeight = 0;

				// Reset the height first to handle resizing
				$('.socialCard').css('height', 'auto');

				// Loop through each div to find the maximum height
				$('.socialCard').each(function () {
					var thisHeight = $(this).outerHeight();
					if (thisHeight > maxHeight) {
						maxHeight = thisHeight;
					}
				});

				// Set each div to the maximum height
				$('.socialCard').css('height', maxHeight + 'px');
			}

			// Initial call to set heights
			setEqualHeight();

			// Optional: Adjust heights on window resize for responsiveness
			$(window).resize(function () {
				setEqualHeight();
			});

			// Function to update the progress bar width
			function updateProgressBar() {
				const progressBar = document.getElementById('progress-bar');
				const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
				const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const progress = (scrollTop / scrollHeight) * 100;
				progressBar.style.width = progress + '%';
			}

			// Add the scroll event listener to the window
			window.addEventListener('scroll', updateProgressBar);

		});

	</script>

	<script>
		function googleTranslateElementInit() {
			new google.translate.TranslateElement({
				pageLanguage: "en",
				includedLanguages: "en,ar,es,pt,fr,it",
				autoDisplay: false
			}, "google_translate_element");

			setTimeout(function () {
				// Remove extra Google Translate default text
				var selectText = document.querySelector(".goog-te-gadget span");
				if (selectText) {
					selectText.style.display = "none";
				}

				// Remove Google Translate branding
				var branding = document.querySelector(".goog-te-gadget-simple span");
				if (branding) {
					branding.remove();
				}
			}, 500);
		}

	</script>
