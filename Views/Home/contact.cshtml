
@{
    ViewBag.Title = "Contact RJ Kapdaaz | Textile Manufacturer in Surat, Gujarat";
    ViewBag.MetaDescription = "Get in touch with RJ Kapdaaz for inquiries about our linen and uniform manufacturing services. Serving Surat, Vapi, Daman, Silvassa, and all over Gujarat.";
    ViewBag.MetaKeywords = "contact RJ Kapdaaz, textile manufacturer Surat, linen and uniform supplier, Gujarat";
}

<section class="breadcrumbSection contactus">
    <div class="text-center">
        <h1>Contact us</h1>
    </div>
</section>
<div class="WrapperContainer section-gap" data-aos="fade-up" data-aos-duration="1000">
    <div class="BlogSection">
        <div class="container-fluid">
            <div class="dividerClass"></div>
            <div class="row marginBottom50">
                <div class="col-md-9">
                    <div class="headingBar">
                        <h3>We’re Listening</h3>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="MapArea">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d516.829000269704!2d72.81220131617994!3d21.161060859620935!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be04f7a122b3eab%3A0x912e775d4f60eb5c!2sRJ%20Kapdaaz!5e0!3m2!1sen!2sin!4v1726469680167!5m2!1sen!2sin" width="100%" height="250" frameborder="0"></iframe>
                        <div class="MapCard">
                            <!--<h5>Visit our store in Surat</h5>-->
                            <div class="addressContainer">
                                <div class="addressBox">
                                    <img src="~/images/icons/location.png" class="img-fluid" loading="lazy" alt="location" width="18" height="18" />
                                    <a href="https://maps.app.goo.gl/j1aSKEuhMLZjqecS6" target="_blank">A-19, Sainath Industrial Society, Bhatar, Udhna - Magdalla Road, Surat - 395007</a>
                                </div>
                                <div class="addressBox">
                                    <img src="~/images/icons/email.png" class="img-fluid" loading="lazy" alt="email" width="18" height="18" />
                                    <a href="mailto:sales@rjkapdaaz.com">sales@rjkapdaaz.com</a>
                                </div>
                                <div class="addressBox">
                                    <img src="~/images/icons/helpdesk.png" class="img-fluid" loading="lazy" alt="phonecall" width="18" height="18" />
                                    <a href="tel:+919106793771">+91 91067 93771</a>
                                </div>
                                <div class="addressBox">
                                    <img src="~/images/icons/phonecall.png" class="img-fluid" loading="lazy" alt="phonecall" width="18" height="18" />
                                   <a href="tel:+919227906693">+91 092279 06693</a>&nbsp;|&nbsp;<a href="tel:+919737339997">+91 097373 39997</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <form class="form-row contactForm" id="contactForm">
                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="text" id="name" name="name" class="form-control" placeholder="Name *" required>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="email" id="email" name="email" class="form-control emailField" placeholder="Email Address *" required>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <input type="number" id="phone" name="phone" class="form-control" placeholder="Number *" required />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <textarea class="form-control" id="message" name="message" rows="4" placeholder="Comment Here.."></textarea>
                        </div>
                        <div class="" style="margin-top: 25px; margin-left: 20px;">
                            <div class="butnSecton">
                                <button type="submit" class="btn blackBtn"><span>Submit</span></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function initMap() {
        var map = new google.maps.Map(document.getElementByClassName('MapArea'), {
            center: { lat: YOUR_LATITUDE, lng: YOUR_LONGITUDE },
            zoom: 14,
            disableDefaultUI: true,  // Disables all the default UI elements
            zoomControl: true,       // Re-enables the zoom control
            mapTypeControl: false,   // Hides the map type selector
        });

        var marker = new google.maps.Marker({
            position: { lat: YOUR_LATITUDE, lng: YOUR_LONGITUDE },
            map: map,
            title: 'RJ Kapdaaz'
        });
    }
</script>
